<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<RootNamespace>StorageWatchAgent</RootNamespace>
	<AssemblyName>StorageWatchAgent</AssemblyName>
	<UserSecretsId>dotnet-StorageWatch-5171660d-2158-404d-801d-e9cb0c54631b</UserSecretsId>
	<WindowsService>true</WindowsService>
	<FileVersion>$(Version)</FileVersion>
	<AssemblyVersion>3.0.0.0</AssemblyVersion>
	<AssemblyInformationalVersion>$(Version)+$(SourceRevisionId)</AssemblyInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
	<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
	<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.3" />
	<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.3" />
	<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.3" />
	<PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.3" />
	<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.3" />
	<PackageReference Include="SourceGear.sqlite3" Version="3.50.2" />
	<PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
	<PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="StorageWatchConfig.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StorageWatch.Shared.Update\StorageWatch.Shared.Update.csproj" />
  </ItemGroup>
</Project>
