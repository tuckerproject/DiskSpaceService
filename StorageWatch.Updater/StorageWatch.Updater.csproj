<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StorageWatch.Updater</RootNamespace>
    <AssemblyName>StorageWatch.Updater</AssemblyName>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <AssemblyInformationalVersion>$(Version)+$(SourceRevisionId)</AssemblyInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SourceGear.sqlite3" Version="3.50.2" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StorageWatch.Shared.Update\StorageWatch.Shared.Update.csproj" />
  </ItemGroup>

</Project>
